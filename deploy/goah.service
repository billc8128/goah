[Unit]
Description=goah goal-oriented agent supervisor
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/goah
ExecStart=/usr/bin/npm --workspace @goah/example-repo-guardian run start -- --daemon
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
